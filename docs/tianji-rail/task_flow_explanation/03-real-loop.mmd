%% 节点、组件边界与PNG由同一份规格生成；PNG布局单独指定。
flowchart TD
  subgraph entry["A · 评估入口与模型加载"]
    entry_n["eval_tianji_rail.py + config/tianji_rail_real_eval.yaml<br/>读取checkpoint的配置 / EMA / 归一化器；检查模型与设备配置，创建Env和Runner<br/>--check-only：模拟输入检查；默认：真实观测影子模式；--motion + 手动开始：运动试验"]
  end
  subgraph env["B · TianjiRailEnv 〔实时观测与设备生命周期〕"]
    history["七路带时间戳历史缓存<br/>三路RGB + 左右臂实际关节FK + 左右手关节<br/>real_world/tianji_rail_env.py<br/>复用BT：recording/camera.py、devices/tianji/model.py"]
    align["get_obs → align_observation<br/>两步30 Hz历史：图像最近匹配；状态线性 / SLERP<br/>检查数据年龄、图像偏差、三路跨度、状态缺口<br/>preprocess_observation：与checkpoint图像设置一致"]
  end
  subgraph runner["C · TianjiRailRealRunner 〔试验管理与独立推理〕"]
    infer["_infer → policy.predict_action<br/>独立推理线程，读对齐观测；输出8步52维目标<br/>env_runner/tianji_rail_real_runner.py<br/>按replanning_steps检查新观测；不保证推理30 Hz"]
    trial["run / _begin / _end<br/>s开始；p接管；y成功；n失败；q退出<br/>操作员定义结果，记录超时、设备中止与接管<br/>切换试验时阻止旧推理结果发布"]
  end
  subgraph runtime["D · TianjiPolicyRuntime 〔定时队列、校验与独立控制〕"]
    schedule["exec_actions → runtime.submit → 控制线程<br/>名义时刻 t0 + i/30 秒；丢弃已过期动作<br/>校验工作空间 / 跳变 / 速度；替换未来队列<br/>双臂线程200 Hz；左手、右手各120 Hz<br/>real_world/tianji_policy_runtime.py<br/>故障或覆盖耗尽：清队列并请求暂停"]
  end
  subgraph device["E · BT 设备接口 〔运动学、伺服、驱动及SDK〕"]
    devices["绝对EEF / 手关节目标 → 设备执行<br/>control/arm/cartesian.py + arm/servo.py<br/>devices/tianji/model.py：FK / IK<br/>devices/tianji/driver.py + sdk.py<br/>devices/wuji/adapter.py：左右手驱动<br/>实际图像 / 状态反馈返回Env"]
  end
  subgraph record["F · 试验记录与汇总 〔Runner 中的 TrialRecorder〕"]
    log["TrialRecorder + summarize_trials 〔env_runner/tianji_rail_real_runner.py〕<br/>逐试验：trial.json / 三路MP4 / events.jsonl / timing.json；会话：session.json / summary.json<br/>成功率 = 成功运动试验 / 所有已开始运动试验；影子试验不进入分母"]
  end
  entry_n --> history
  entry_n --> infer
  history --> align
  align -->|"obs + t0"| infer
  infer -->|"预测动作"| schedule
  trial -->|"开始 / 暂停"| schedule
  schedule -->|"设备目标"| devices
  devices -->|"实际反馈闭环"| history
  devices -.-> log
  schedule -.-> log
