%% 节点、组件边界与PNG由同一份规格生成；PNG布局单独指定。
flowchart TD
  subgraph train["A · 主Policy训练与参数更新"]
    batch["DataLoader → batch → GPU<br/>三路图像各(B,2,3,480,640)<br/>EEF(B,2,12) / 手(B,2,40) / 动作(B,16,52)"]
    loss["self.model.compute_loss(batch)<br/>Policy负责归一化、加噪、预测噪声与MSE<br/>Workspace检查损失有限；按累积组缩放loss"]
    backward["loss.backward()<br/>计算并累积主Policy的梯度<br/>编码器与Transformer一起学习"]
    update["满足累积步数，或到本epoch最后一批<br/>optimizer.step → zero_grad → lr_scheduler.step<br/>ema.step(self.model)：同步平滑更新EMA<br/>默认累积步数1，每个batch更新一次"]
    batchlog["记录batch损失、学习率与global_step<br/>还有batch：继续读取<br/>本epoch结束：train_loss取batch均值<br/>global_step记录已完成batch数"]
  end
  subgraph eval["B · 评估、checkpoint与日志"]
    select["选择生成动作的策略并policy.eval()<br/>use_ema=true：self.ema_model<br/>否则：self.model"]
    offline["rollout_every：env_runner.run(policy)<br/>本任务是OfflineRunner，比较执行段与标签<br/>输出位置 / 旋转 / 手关节误差；空验证则跳过"]
    val["val_every：计算val_loss<br/>torch.no_grad + self.model.compute_loss<br/>使用主模型计算验证噪声MSE；不反向传播"]
    sample["sample_every：训练batch动作采样检查<br/>policy.predict_action → action_pred(B,16,52)<br/>完整预测与训练标签比较MSE<br/>启用EMA时，这一步使用EMA模型"]
    save["checkpoint_every：保存latest与候选TopK<br/>保存前epoch前进到下一轮，global_step加1<br/>BaseWorkspace保存cfg / state_dicts / pickles<br/>policy.train()；合并本轮最后一批与评估日志<br/>继续下一epoch；结束时等待保存线程"]
  end
  batch --> loss
  loss --> backward
  backward --> update
  update --> batchlog
  batchlog -->|"下一batch"| batch
  batchlog -->|"epoch训练结束"| select
  select --> offline
  offline --> val
  val --> sample
  sample --> save
  save -.-> batch
