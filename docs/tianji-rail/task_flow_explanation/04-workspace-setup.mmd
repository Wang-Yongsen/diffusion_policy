%% 节点、组件边界与PNG由同一份规格生成；PNG布局单独指定。
flowchart TD
  subgraph entry["A · train.py：解析配置，按cfg._target_创建Workspace"]
    entry["Task + Train YAML + 命令行覆盖 → cfg → Workspace(cfg) → workspace.run()"]
  end
  subgraph state["B · __init__：创建Workspace持有的训练状态"]
    main["self.model：主Policy<br/>hydra.instantiate(cfg.policy)<br/>内部含编码器 / Transformer / 调度器<br/>训练梯度更新作用于这个模型"]
    ema["self.ema_model：EMA Policy<br/>deepcopy(self.model)<br/>use_ema=true时创建<br/>由EMA更新器平滑更新参数"]
    optim["self.optimizer + 计数器<br/>self.model.get_optimizer(...)<br/>global_step=0；epoch=0<br/>优化器持有主Policy的可训练参数"]
  end
  subgraph resources["C · run()：检查恢复点，创建本次运行的资源，再进入训练循环"]
    resume["1  检查是否恢复训练<br/>resume=true且latest.ckpt存在<br/>load_checkpoint → 主 / EMA / 优化器<br/>恢复epoch、global_step"]
    data["2  Dataset + 两个DataLoader<br/>cfg.task.dataset实例化Dataset<br/>训练loader + 验证loader<br/>get_validation_dataset()获取验证集"]
    norm["3  归一化器<br/>dataset.get_normalizer()<br/>仅训练来源拟合<br/>set_normalizer复制给主模型与EMA"]
    lr["4  学习率调度器 + EMA更新器<br/>warmup / cosine；关联optimizer<br/>EMA更新器关联self.ema_model<br/>恢复时按epoch重建调度进度"]
    runner["5  TianjiRailOfflineRunner<br/>cfg.task.env_runner实例化<br/>output_dir来自Workspace<br/>本导轨配置执行留出动作评估"]
    logging["6  日志、TopK与设备迁移<br/>logs.json.txt + 日志接口<br/>TopKCheckpointManager<br/>模型 / EMA / optimizer迁移到GPU"]
    loop["进入epoch循环：从self.epoch运行到num_epochs总目标"]
  end
  entry --> main
  main --> ema
  main --> optim
  main --> resume
  resume --> data
  data --> norm
  norm --> lr
  lr --> runner
  runner --> logging
  logging --> loop
