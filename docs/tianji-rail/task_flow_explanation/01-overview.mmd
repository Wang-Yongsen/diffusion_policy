%% 节点、组件边界与PNG由同一份规格生成；PNG布局单独指定。
flowchart TD
  subgraph data["A · 数据处理 〔bimanual-teleop项目；bimanual-teleop环境〕"]
    capture["1  示范采集<br/>Quest / 手套 → 双臂双手<br/>三路 RGB + 实测状态 + 已提交指令<br/>cli/teleop_quest_tianji.py<br/>recording/recorder.py + sink.py<br/>recording/camera.py + spool.py"]
    finalize["2  原始记录整理<br/>raw_spool → MP4 + raw.zarr<br/>检查视频、重建实测末端位姿<br/>recording/finalize.py<br/>recording/storage.py<br/>BT入口：scripts/finalize_recording.py"]
    convert["3  对齐、修复与转换<br/>10 Hz；图像匹配 / 状态插值<br/>动作保持过去目标；无效点切段<br/>recording/convert.py<br/>configs/recording_conversion.yaml<br/>BT入口：scripts/convert_recording.py"]
    zarr["输出：训练 zarr · 三路 RGB / 12维 EEF / 40维手关节 / 52维动作 / 边界及追溯"]
  end
  subgraph train["B · 数据接口与训练 〔DP；train.py + Task / Train YAML 组织调用〕"]
    dataset["4  Dataset + DataLoader<br/>按原始演示划分训练 / 验证<br/>片段内采样：2步观测 + 16步动作<br/>原图480×640；训练来源拟合归一化<br/>dataset/tianji_rail_image_dataset.py<br/>model/common/normalizer.py"]
    workspace["5  Workspace<br/>训练循环、反向传播、优化器<br/>学习率、EMA、验证、日志与保存<br/>workspace/<br/>train_diffusion_transformer_<br/>hybrid_workspace.py"]
    policy["6  Policy + 扩散模型<br/>观测编码 → Transformer 条件去噪<br/>训练：compute_loss<br/>推理：predict_action → 8步动作<br/>policy/diffusion_transformer_<br/>hybrid_image_policy.py"]
    ckpt["7  checkpoint<br/>模型 + EMA + 归一化器 + 配置 + 训练状态<br/>workspace/base_workspace.py"]
  end
  subgraph offline["C · 离线评估 〔DP；读取留出数据〕"]
    off["eval.py → TianjiRailOfflineRunner<br/>env_runner/tianji_rail_offline_runner.py<br/>预测 vs 标签[1:9] → 位置mm / 旋转° / 手关节°<br/>输出：eval_log.json + offline_report.json"]
  end
  subgraph real["D · 真机闭环评估 〔DP；本地设备接口快照〕"]
    live["eval_tianji_rail.py → Env / Runner / Runtime<br/>对齐实测观测 → 推理 → 定时目标 → 设备反馈<br/>tianji_rail_env.py / tianji_rail_real_runner.py<br/>tianji_policy_runtime.py → 事件日志、成功率"]
  end
  capture --> finalize
  finalize --> convert
  convert --> zarr
  zarr --> dataset
  dataset --> workspace
  workspace -->|"调用"| policy
  workspace --> ckpt
  ckpt -->|"加载 EMA / 模型"| off
  ckpt --> live
  dataset -.->|"独立验证窗口"| off
