# 按路径和文件类型排除生成文件；Git 不支持按文件大小设置忽略规则。
# 源码、配置、文档图片、仿真网格及纹理应保留在版本控制中。

# 本地数据、训练结果、真机评估记录和临时工作目录
/data/
/data_local/
/outputs/
/results/
/logs/
/multirun/
/wys/
/tmp/
/temp/
wandb/
_wandb/
.hydra/

# 模型权重和导出的模型（即使保存到 data/ 之外也忽略）
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors

# 数据集、回放缓存和诊断数组
*.zarr/
*.hdf5
*.h5
*.npy
*.npz
*.pkl
*.pickle

# 数据、诊断报告的压缩归档；解压后的文档仍可跟踪
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.tar.xz
*.txz
*.7z
*.rar

# 采集与评估视频、运行日志
*.mp4
*.avi
*.mov
*.mkv
*.log
logs.json.txt

# Python 字节码和本地编译扩展
__pycache__/
*.py[cod]
*$py.class
*.so
!/third_party/bimanual_teleop/vendor/tianji/SDK_PYTHON/*.so

# Python 构建与安装产物
/bin/
/build/
/dist/
/downloads/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# 虚拟环境仅匹配根目录，避免忽略源码目录 diffusion_policy/env/
/.venv/
/venv/
/env/
/envs/
/.conda/
/.Python
__pypackages__/

# 测试、类型检查、Notebook 和其他工具缓存
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.cover
*.py,cover
.dmypy.json
dmypy.json
.ipynb_checkpoints/
/docs/_build/

# 本机配置与认证信息
/fuse.cfg
/ray/auth.json
/.python-version
/.vscode/*
!/.vscode/settings.json
!/.vscode/bashrc
.idea/
.spyderproject
.spyproject
.ropeproject/

# 编辑器临时文件和操作系统元数据
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# GitHub 新增依赖的本地产物

